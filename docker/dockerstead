#!/usr/bin/env bash

# DockerStead 管理脚本
# 使用方式:
#   ./dockerstead up       - 启动所有服务
#   ./dockerstead down     - 停止所有服务
#   ./dockerstead status  - 查看服务状态
#   ./dockerstead ssh    - 进入 PHP 容器
#   ./dockerstead mysql  - 进入 MySQL 容器

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yaml"
ENV_FILE="$SCRIPT_DIR/.env"

# 检查 Docker 和 Docker Compose
check_requirements() {
    if ! command -v docker &> /dev/null; then
        echo -e "${RED}错误: Docker 未安装${NC}"
        exit 1
    fi

    if ! docker compose version &> /dev/null; then
        echo -e "${RED}错误: Docker Compose 未安装${NC}"
        exit 1
    fi

    if [ ! -f "$COMPOSE_FILE" ]; then
        echo -e "${RED}错误: docker-compose.yaml 不存在${NC}"
        exit 1
    fi

    # 加载 .env 文件
    if [ -f "$ENV_FILE" ]; then
        set -a
        source "$ENV_FILE"
        set +a
    fi
}

# 显示帮助信息
show_help() {
    echo "DockerStead - 本地开发环境管理脚本"
    echo ""
    echo "使用方法: $0 <命令>"
    echo ""
    echo "可用命令:"
    echo "  up         启动所有服务"
    echo "  down       停止所有服务"
    echo "  restart    重启所有服务"
    echo "  status     查看服务状态"
    echo "  ps         查看容器列表"
    echo "  logs       查看日志 (支持服务名)"
    echo "  ssh        进入 PHP 容器"
    echo "  mysql      进入 MySQL 容器"
    echo "  postgres   进入 PostgreSQL 容器"
    echo "  redis      进入 Redis 容器"
    echo "  shell      进入容器 shell"
    echo "  clean      清理所有数据"
    echo "  ports      显示映射的端口"
    echo "  help       显示帮助信息"
}

# 启动服务
cmd_up() {
    echo -e "${BLUE}[+] 启动 DockerStead...${NC}"
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d
    echo -e "${GREEN}[✓] DockerStead 已启动${NC}"
    echo -e "${YELLOW}[i] 访问以下地址:${NC}"
    echo "    - Nginx: http://localhost"
    echo "    - Adminer: http://localhost:8080"
    echo "    - Mailpit: http://localhost:8025"
    echo "    - Minio Console: http://localhost:9001"
    echo "    - Meilisearch: http://localhost:7700"
    echo "    - Elasticsearch: http://localhost:9200"
}

# 停止服务
cmd_down() {
    echo -e "${BLUE}[-] 停止 DockerStead...${NC}"
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down
    echo -e "${GREEN}[✓] DockerStead 已停止${NC}"
}

# 重启服务
cmd_restart() {
    cmd_down
    sleep 1
    cmd_up
}

# 查看状态
cmd_status() {
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps
}

# 查看容器列表
cmd_ps() {
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps
}

# 查看日志
cmd_logs() {
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" logs -f "${1:-}"
}

# 进入 PHP 容器
cmd_ssh() {
    docker exec -it dockerstead_php sh
}

# 进入 MySQL 容器
cmd_mysql() {
    docker exec -it dockerstead_mysql mysql -uroot -psecret
}

# 进入 PostgreSQL 容器
cmd_postgres() {
    docker exec -it dockerstead_postgres psql -U vagrant
}

# 进入 Redis 容器
cmd_redis() {
    docker exec -it dockerstead_redis redis-cli
}

# 进入任意容器
cmd_shell() {
    if [ -z "$1" ]; then
        echo -e "${RED}错误: 请指定容器名称${NC}"
        echo "可用容器: nginx, php, mysql, postgres, redis, mailpit, minio, mongodb, adminer"
        exit 1
    fi
    docker exec -it "dockerstead_$1" sh
}

# 清理数据
cmd_clean() {
    echo -e "${RED}[!] 警告: 将删除所有数据卷${NC}"
    read -p "确认继续? (y/n): " confirm
    if [ "$confirm" = "y" ]; then
        docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down -v
        echo -e "${GREEN}[✓] 所有数据已清理${NC}"
    fi
}

# 显示端口
cmd_ports() {
    echo -e "${BLUE}[i] 映射的端口:${NC}"
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps --format json | docker compose -f "$COMPOSE_FILE" ps --format json 2>/dev/null || \
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" port 2>&1 || true

    echo ""
    echo "服务端口映射:"
    echo "  nginx:      80, 443"
    echo "  mysql:     3306"
    echo "  postgresql: 5432"
    echo "  redis:     6379"
    echo "  mailpit:   8025, 1025"
    echo "  minio:     9000, 9001"
    echo "  meilisearch: 7700"
    echo "  elasticsearch: 9200, 9300"
    echo "  mongodb:   27017"
    echo "  adminer:   8080"
}

# 主命令处理
case "${1:-help}" in
    up)
        check_requirements
        cmd_up
        ;;
    down)
        check_requirements
        cmd_down
        ;;
    restart)
        check_requirements
        cmd_restart
        ;;
    status|ps)
        check_requirements
        cmd_ps
        ;;
    logs)
        check_requirements
        cmd_logs "${2:-}"
        ;;
    ssh)
        check_requirements
        cmd_ssh
        ;;
    mysql)
        check_requirements
        cmd_mysql
        ;;
    postgres)
        check_requirements
        cmd_postgres
        ;;
    redis)
        check_requirements
        cmd_redis
        ;;
    shell)
        check_requirements
        cmd_shell "${2:-}"
        ;;
    clean)
        check_requirements
        cmd_clean
        ;;
    ports)
        check_requirements
        cmd_ports
        ;;
    help|*)
        show_help
        ;;
esac