# Host paths (Windows Docker Desktop accepts D:/... paths)
CODE_PATH=D:/Code
CERT_PATH=../.certificates

# FrankenPHP HTTP ports (the Nginx/FPM stack continues to use ports 80/443).
FRANKENPHP82_PORT=8082
FRANKENPHP83_PORT=8083
FRANKENPHP84_PORT=8084
FRANKENPHP85_PORT=8085
# Set this to a project document root when serving a single project directly.
FRANKENPHP_ROOT=/home/vagrant/code

# Homestead-compatible database defaults
MYSQL_DATABASE=homestead
MYSQL_USER=homestead
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret
POSTGRES_DB=homestead
POSTGRES_USER=homestead
POSTGRES_PASSWORD=secret

# Change these when a host port is already occupied.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379
MEMCACHED_PORT=11211
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
ADMINER_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEILISEARCH_PORT=7700
ELASTICSEARCH_HTTP_PORT=9200
MONGODB_PORT=27017
